generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(RESEARCH_MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ownedProjects     ResearchProject[]  @relation("ProjectOwner")
  projectMembers    ProjectMember[]
  tasksAssigned     Task[]             @relation("TaskAssignee")
  tasksCreated      Task[]             @relation("TaskCreator")
  addedPapers       Paper[]            @relation("PaperAdder")
  experiments       Experiment[]       @relation("ExperimentResearcher")
  observations      Observation[]
  findings          Finding[]
  activityLogs      ActivityLog[]
  comments          Comment[]
  reviews           Review[]
  notifications     Notification[]
}

enum Role {
  RESEARCH_LEAD
  RESEARCH_MEMBER
  SUPERVISOR
}

model ResearchProject {
  id              String        @id @default(uuid())
  title           String
  description     String
  researchArea    String
  status          ProjectStatus @default(PLANNING)
  startDate       DateTime?
  expectedEndDate DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  createdById     String
  createdBy       User          @relation("ProjectOwner", fields: [createdById], references: [id], onDelete: Restrict)

  members         ProjectMember[]
  questions       ResearchQuestion[]
  papers          Paper[]
  tasks           Task[]
  experiments     Experiment[]
  findings        Finding[]
  activityLogs    ActivityLog[]
  comments        Comment[]

  @@index([createdById])
  @@index([status])
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  PAUSED
  COMPLETED
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole @default(MEMBER)
  joinedAt  DateTime    @default(now())

  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
}

enum ProjectRole {
  LEAD
  MEMBER
  SUPERVISOR
}

model ResearchQuestion {
  id        String   @id @default(uuid())
  projectId String
  question  String
  status    String   @default("OPEN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project   ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Paper {
  id              String        @id @default(uuid())
  projectId       String
  title           String
  authors         String
  publicationYear Int?
  doi             String?
  url             String?
  researchArea    String?
  tags            String[]
  notes           String?
  readingStatus   ReadingStatus @default(TO_READ)
  addedById       String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  project         ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  addedBy         User?           @relation("PaperAdder", fields: [addedById], references: [id], onDelete: SetNull)

  @@index([projectId])
}

enum ReadingStatus {
  TO_READ
  READING
  REVIEWED
}

model Task {
  id          String       @id @default(uuid())
  projectId   String
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime?
  assigneeId  String?
  createdById String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee    User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy   User?           @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([assigneeId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model Experiment {
  id               String           @id @default(uuid())
  title            String
  projectId        String
  objective        String
  method           String
  dataset          String?
  modelOrTechnique String?
  parameters       String?
  status           ExperimentStatus @default(PLANNED)
  researcherId     String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  project          ResearchProject  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  researcher       User?            @relation("ExperimentResearcher", fields: [researcherId], references: [id], onDelete: SetNull)
  
  results          ExperimentResult[]
  observations     Observation[]
  findings         Finding[]
  comments         Comment[]
  reviews          Review[]

  @@index([projectId])
  @@index([researcherId])
}

enum ExperimentStatus {
  PLANNED
  RUNNING
  COMPLETED
  FAILED
  ARCHIVED
}

model ExperimentResult {
  id           String     @id @default(uuid())
  experimentId String
  metricName   String
  metricValue  Float
  unit         String?
  createdAt    DateTime   @default(now())

  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId])
}

model Observation {
  id           String     @id @default(uuid())
  experimentId String
  content      String
  authorId     String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  author       User       @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([experimentId])
}

model Finding {
  id           String      @id @default(uuid())
  title        String
  description  String
  projectId    String
  authorId     String
  experimentId String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  project      ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author       User            @relation(fields: [authorId], references: [id], onDelete: Restrict)
  experiment   Experiment?     @relation(fields: [experimentId], references: [id], onDelete: SetNull)
  comments     Comment[]

  @@index([projectId])
  @@index([experimentId])
}

model ActivityLog {
  id          String   @id @default(uuid())
  projectId   String
  action      String 
  actorId     String
  entityType  String
  entityId    String?
  entityTitle String?
  metadata    String?  // JSON
  createdAt   DateTime @default(now())

  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor       User            @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([entityId])
  @@index([createdAt])
}

model Comment {
  id           String   @id @default(uuid())
  content      String
  authorId     String
  projectId    String
  experimentId String?
  findingId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  author       User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  project      ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  experiment   Experiment?     @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  finding      Finding?        @relation(fields: [findingId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([experimentId])
  @@index([findingId])
}

model Review {
  id           String       @id @default(uuid())
  experimentId String
  reviewerId   String
  status       ReviewStatus @default(PENDING)
  comment      String?
  reviewedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  experiment   Experiment   @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  reviewer     User         @relation(fields: [reviewerId], references: [id], onDelete: Cascade)
}

enum ReviewStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

model Notification {
  id          String           @id @default(uuid())
  userId      String
  type        NotificationType
  title       String
  message     String
  link        String?
  isRead      Boolean          @default(false)
  createdAt   DateTime         @default(now())

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  emails      EmailDelivery[]

  @@index([userId])
}

enum NotificationType {
  INVITE
  REVIEW_REQUEST
  REVIEW_APPROVED
  REVIEW_CHANGES
  TASK_ASSIGN
  TASK_DEADLINE
  GENERAL
}

model EmailDelivery {
  id             String      @id @default(uuid())
  notificationId String
  resendId       String      @unique
  status         EmailStatus @default(PENDING)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
}

enum EmailStatus {
  PENDING
  DELIVERED
  BOUNCED
  FAILED
}
